# ─── API ──────────────────────────────────────────────────────────────────────
# Base URL for the REST API (sessions, branches, messages, usage)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL for the streaming Lambda function (NDJSON response streaming)
NEXT_PUBLIC_STREAMING_LAMBDA_URL=https://<your-lambda-url>.lambda-url.<region>.on.aws

# ─── AWS Cognito ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_COGNITO_USER_POOL_ID=<region>_<pool-id>
NEXT_PUBLIC_COGNITO_CLIENT_ID=<your-app-client-id>
NEXT_PUBLIC_COGNITO_REGION=us-east-1
